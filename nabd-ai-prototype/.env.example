# NABD AI Decision Review - isolated synthetic prototype
#
# Copy to .env and adjust only if you must. Every value below is a placeholder or a local
# demo value. There are no real credentials here, and none may ever be added: the only
# secret-shaped values in this file are synthetic local-demo strings used by an isolated
# workbench that holds no real, personal, customer or institutional data.

# ---------------------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------------------
# Database (local demo only)
#
# The database is a throwaway demo store. There is deliberately no configuration field for
# an operational, warehouse or production DSN: writing to an operational system is a
# prohibited integration, and the prohibited-path tests assert that no such variable is
# consumed anywhere in the application.
# ---------------------------------------------------------------------------------------
POSTGRES_DB=nabd_prototype
POSTGRES_USER=nabd_owner
POSTGRES_PASSWORD=nabd_owner_demo
POSTGRES_APP_USER=nabd_app
POSTGRES_APP_PASSWORD=nabd_app_demo
DATABASE_URL=postgresql+psycopg://nabd_app:nabd_app_demo@db:5432/nabd_prototype
OWNER_DATABASE_URL=postgresql+psycopg://nabd_owner:nabd_owner_demo@db:5432/nabd_prototype

# ---------------------------------------------------------------------------------------
# Demo sessions
#
# Synthetic server-signed sessions only. This is not an identity provider, not OAuth and
# not a password system.
# ---------------------------------------------------------------------------------------
DEMO_SESSION_SECRET=replace-with-any-local-random-string
DEMO_SESSION_TTL_SECONDS=3600

# ---------------------------------------------------------------------------------------
# Model gateway
#
# mock is the default and requires no credentials and no outbound network access.
#
# live is a test-only, explicitly pinned mode. Setting MODEL_MODE=live requires all three
# of LIVE_MODEL_ENDPOINT, LIVE_MODEL_NAME and LIVE_MODEL_CONFIG_ID; the endpoint must be a
# single https URL; and there is no fallback, no model discovery and no tool calling. Put a
# real key in your own untracked .env only, never here, never in a fixture, a log, a packet
# or a screenshot.
# ---------------------------------------------------------------------------------------
MODEL_MODE=mock
LIVE_MODEL_ENDPOINT=
LIVE_MODEL_NAME=
LIVE_MODEL_CONFIG_ID=
LIVE_MODEL_API_KEY=

# ---------------------------------------------------------------------------------------
# Retrieval
#
# Vector retrieval stays disabled by default. It can never bypass the lexical source
# eligibility filters and it is never required for a passing TEVV run.
# ---------------------------------------------------------------------------------------
ENABLE_VECTOR_RETRIEVAL=false

# ---------------------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=
